# BlockDesign 2.0 — Multi-stage frontend build
#
# Stage 1 (builder): compiles ClojureScript inside the official penpot devenv
#   image, which already has JVM, Clojure, Node.js and shadow-cljs installed.
#   The shared.js WASM artifact is already committed to the repo, so Emscripten
#   is not needed here.
#
# Stage 2 (final): packages the compiled bundle into the same nginx-based image
#   that penpot uses for its official frontend, but with our own nginx config
#   that proxies /assistant-api/ to the Daily Assistant backend.
#
# Runtime environment variables (set in docker-compose):
#   PENPOT_FLAGS        — space-separated feature flags
#   PENPOT_PUBLIC_URI   — public URL of BlockDesign (https://blockdesign.blockmaker.net)
#   PENPOT_OIDC_NAME    — label shown on the SSO login button (e.g. "Daily Assistant")
#   PENPOT_BACKEND_URI  — internal URL of penpot-backend (default: http://penpot-backend:6060)
#   PENPOT_EXPORTER_URI — internal URL of penpot-exporter (default: http://penpot-exporter:6061)
#
# Build from blockdesign-core repo root:
#
#   docker build \
#     -f docker/images/Dockerfile.blockdesign-frontend \
#     -t ghcr.io/blockmakercompany/blockdesign-frontend:2.0 \
#     .
#
# ---------------------------------------------------------------------------
# Stage 1 — Build
# ---------------------------------------------------------------------------
FROM penpotapp/devenv:latest AS builder

WORKDIR /build

# Copy source — honour sparse checkout by copying what's available.
COPY . .

WORKDIR /build/frontend

# Install JS dependencies (postinstall also builds plugins-runtime).
RUN pnpm install --frozen-lockfile

# Compile ClojureScript bundles (main app + web worker) and static assets.
# shared.js is already committed, so no Emscripten needed.
RUN pnpm run build:app && pnpm run build:app:assets

# ---------------------------------------------------------------------------
# Stage 2 — Final image (same base as penpotapp/frontend:2.16)
# ---------------------------------------------------------------------------
FROM nginxinc/nginx-unprivileged:1.30.2-alpine
LABEL maintainer="Blockmaker <hola@blockmaker.net>"

USER root

RUN set -ex; \
    apk update; \
    apk upgrade; \
    apk add --no-cache bash gettext; \
    rm -rf /var/cache/apk/*; \
    addgroup -g 1001 penpot; \
    adduser -D -H -u 1001 -s /bin/false -h /opt/penpot -G penpot penpot; \
    mkdir -p /opt/data/assets; \
    chown -R penpot:penpot /opt/data; \
    mkdir -p /etc/nginx/conf.d

# Copy compiled bundle from builder stage
COPY --from=builder /build/frontend/resources/public/ /var/www/app/

# Runtime config.js template — entrypoint injects PENPOT_FLAGS, PENPOT_PUBLIC_URI
# and PENPOT_OIDC_NAME into this file at container start so OIDC login works.
COPY docker/images/files/config.js /var/www/app/js/config.js

# BlockDesign nginx config (with /assistant-api/ proxy, no plugin injection)
COPY docker/images/files/nginx-blockdesign.conf /etc/nginx/conf.d/default.conf

# Entrypoint: injects runtime config then starts nginx
COPY docker/images/files/nginx-blockdesign-entrypoint.sh /entrypoint.sh

RUN chown -R 1001:0 /var/cache/nginx; \
    chmod -R g+w /var/cache/nginx; \
    chown -R 1001:0 /etc/nginx; \
    chmod -R g+w /etc/nginx; \
    chown -R 1001:0 /var/www; \
    chmod -R g+w /var/www; \
    chmod +x /entrypoint.sh

USER penpot:penpot

ENTRYPOINT ["/bin/bash", "/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
